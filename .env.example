# Copy to .env before running: cp .env.example .env
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg://bookstore:bookstore123@localhost:5433/bookstore_db
# ^ Used when the app runs on your machine (start.bat / python run.py).
#   Inside Docker Compose the api service overrides this with postgres:5432.
SECRET_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS_FROM_SECRETS_TOKEN_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo administrator, created automatically on first start against a persistent
# database (skipped for in-memory test databases). Set SEED_ADMIN=false in production.
SEED_ADMIN=true
ADMIN_EMAIL=admin@bookstorepro.com
ADMIN_PASSWORD=admin-password-123
ADMIN_NAME=Store Administrator

# Optional overrides used by docker-compose.yml (defaults shown).
# POSTGRES_USER=bookstore
# POSTGRES_PASSWORD=bookstore123
# POSTGRES_DB=bookstore_db
# POSTGRES_PORT=5433
# API_PORT=8000
# FRONTEND_PORT=3000
